  <!-- Клиентский скрипт переключения табов, фильтрации каталога и предвыбора в калькуляторе -->
  <script>
    function initHomeInteractions() {
      // 1. Переключатель "Нужно привезти" / "Вывезти мусор и спецтехника"
      const tabBring = document.getElementById('switch-tab-bring');
      const tabRemove = document.getElementById('switch-tab-remove');
      const panelBring = document.getElementById('panel-bring');
      const panelRemove = document.getElementById('panel-remove');

      if (tabBring && tabRemove && panelBring && panelRemove) {
        tabBring.addEventListener('click', () => {
          tabBring.setAttribute('aria-pressed', 'true');
          tabRemove.setAttribute('aria-pressed', 'false');
          tabBring.className =
            'min-h-[44px] px-4 py-2 bg-primary text-on-primary font-label-lg text-label-lg uppercase font-bold tracking-wider transition-colors';
          tabRemove.className =
            'min-h-[44px] px-4 py-2 bg-transparent text-primary hover:bg-surface-container font-label-lg text-label-lg uppercase font-bold tracking-wider transition-colors';
          panelBring.classList.remove('hidden');
          panelBring.classList.add('grid');
          panelRemove.classList.add('hidden');
          panelRemove.classList.remove('grid');
        });

        tabRemove.addEventListener('click', () => {
          tabRemove.setAttribute('aria-pressed', 'true');
          tabBring.setAttribute('aria-pressed', 'false');
          tabRemove.className =
            'min-h-[44px] px-4 py-2 bg-primary text-on-primary font-label-lg text-label-lg uppercase font-bold tracking-wider transition-colors';
          tabBring.className =
            'min-h-[44px] px-4 py-2 bg-transparent text-primary hover:bg-surface-container font-label-lg text-label-lg uppercase font-bold tracking-wider transition-colors';
          panelRemove.classList.remove('hidden');
          panelRemove.classList.add('grid');
          panelBring.classList.add('hidden');
          panelBring.classList.remove('grid');
        });
      }

      // 2. Фильтрация каталога по категориям (Все / Стройка / Сад / Печь)
      const catPills = document.querySelectorAll('.cat-pill');
      const cards = document.querySelectorAll('.material-card');

      function applyCategoryFilter(cat: string) {
        catPills.forEach((pill) => {
          const pillCat = pill.getAttribute('data-cat-filter');
          pill.setAttribute('aria-pressed', String(pillCat === cat));
          if (pillCat === cat) {
            pill.className =
              'cat-pill min-h-[44px] px-3.5 py-2 bg-primary text-on-primary font-label-technical text-label-technical uppercase tracking-wider font-bold';
          } else {
            pill.className =
              'cat-pill min-h-[44px] px-3.5 py-2 bg-surface text-on-surface hover:bg-surface-container font-label-technical text-label-technical uppercase tracking-wider font-bold border border-surface-variant';
          }
        });

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      }

      catPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const cat = pill.getAttribute('data-cat-filter') || 'all';
          applyCategoryFilter(cat);
        });
      });

      document.querySelectorAll('.branch-tile').forEach((tile) => {
        tile.addEventListener('click', () => {
          const targetCat = tile.getAttribute('data-filter-target');
          if (targetCat) applyCategoryFilter(targetCat);
        });
      });

      // 3. Кнопки "Заказать" / "Вызвать" -> предвыбор позиции в калькуляторе и плавный скролл
      document.querySelectorAll('.order-trigger-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-order-type') as 'material' | 'service';
          const id = btn.getAttribute('data-order-id') || '';
          window.dispatchEvent(
            new CustomEvent('sr21:select-item', {
              detail: { type, id },
            })
          );
          const calcSection = document.getElementById('section-calculator');
          if (calcSection) {
            calcSection.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    }

    initHomeInteractions();
  </script>
</BaseLayout>
